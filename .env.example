# ops-portal 环境变量
# 复制为 .env 后填入真实值：cp .env.example .env && chmod 600 .env
# 本文件只放示例值，真实秘密永远不入库。

# --- Compose ---
COMPOSE_PROJECT_NAME=ops-portal

# --- 对外 ---
# portal-nginx 宿主机 HTTPS 端口（workwork 的 xray-forward 已占 443，
# 同机部署时不能绑 443；独立主机可改为 443）。
PORTAL_HTTPS_PORT=8443
# 公网域名（CF 橙云，全代理）
OPS_DOMAIN=ops.yinghuoren.com

# --- 后端（仅内网）---
# 名义端口：backend healthcheck、nginx upstream、portal-agent-compose、
# deploy.sh 均按 8319 写死联动，改值需全链路同步，勿单独修改。
PORTAL_BACKEND_PORT=8319

# --- 受信代理（backend 只认这些来源透传的 X-Cert-* 头）---
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
TRUSTED_PROXY_HOSTS=portal-nginx

# --- 边缘透传头字段名（以 CF 面板实际配置对齐）---
CERT_VERIFY_HEADER=X-Cert-Verify
CERT_SERIAL_HEADER=X-Cert-Serial
CERT_SUBJECT_HEADER=X-Cert-Subject
CERT_FINGERPRINT_HEADER=X-Cert-Fingerprint

# --- 本地开发（无 CF 时允许无证访问 whoami，仅 dev）---
DEV_ALLOW_NO_CERT=

# --- Cloudflare API（证书自管：发证/吊销走 CF 托管 CA，见 docs/cf-edge.md）---
CF_API_TOKEN=
CF_ZONE_ID=

# --- Agent（本地 dev 联调演示用；生产每台被管机单独下发）---
PORTAL_AGENT_ID=local-dev
# dev 走 env 直传即可；生产被管机用 portal-agent-compose.yml 的 agent-token
# 0600 落盘文件（PORTAL_AGENT_TOKEN_FILE），勿与 backend 的同名回退开关混用
PORTAL_AGENT_TOKEN=change-me-dev-only
# 被管 compose 项目白名单（逗号分隔，agent 只操作这些项目的容器）
PORTAL_AGENT_COMPOSE_PROJECTS=ops-portal
# 被管站点目录（name:/path 逗号分隔，供 agent 上报 git 版本）
PORTAL_AGENT_SITES=
# deploy 路径映射（project:/宿主机绝对路径 逗号分隔，deploy 命令的 compose 工作目录；
# agent 容器须以同路径只读挂载这些目录（源 == 目标），否则 compose 解析错位。
# 例：- /srv/hotspot:/srv/hotspot:ro，且此处填 hotspot:/srv/hotspot）
PORTAL_AGENT_DEPLOY_DIRS=
# Agent 回连地址（本地 dev 走内网，生产填 https://ops.yinghuoren.com）
PORTAL_URL=http://portal-backend:8319

# --- 数据保留（见 docs/database.md）---
# 审计保留天数（默认 180，启动与备份前清理）
AUDIT_RETENTION_DAYS=180
# 排队命令有效期（默认 24h，agent 久离线后上线不再执行过期命令）
COMMAND_TTL=24h
# 原生站点拨测间隔（默认 60s，最小 5s）
OPS_PROBE_INTERVAL=60s
# 拨测目标 SSRF 防线：ops_url 默认拒绝解析到环回/私网/链路本地地址
# （注册时与建连时双重校验）。纯内网自托管联调才放开，生产必须留空。
OPS_PROBE_ALLOW_PRIVATE=

# --- 告警（见 docs/portal-agent-protocol.md「心跳超时告警」）---
# 心跳超时判定：多久无心跳视为 agent 掉线（默认 60s）
AGENT_OFFLINE_AFTER=60s
# 同一告警的重复冷却期（默认 30m；告警写入审计，action=alert.*）
ALERT_COOLDOWN=30m

# --- Docker 基础镜像版本（跨项目统一）---
# 生效位置（随 git 发布，服务器 git pull 即生效，无需拷贝 .env）：
#   docker-compose.yml 中的 ${VAR:-默认值}，以及各 Dockerfile 的 ARG 默认值——
#   两处默认值保持一致。
# 本段仅为升级对照表；不要往实际 .env 里填这些变量（.env 不入库，
# 服务器收不到，会造成本地与服务器双源漂移）。.env 覆盖仅用于临时验证。
# 全局统一值：Go 1.26.6 / Alpine 3.24.1 / Bun 1.3.14 / Nginx 1.30.4，
# 与 hotspot、workwork（含 media_center / music_player 子模块）对齐。
# 升级任一基础镜像时：改 compose/Dockerfile 中的默认值 + 同步其他仓库，保持矩阵一致。
BUN_VERSION=1.3.14
GO_VERSION=1.26.6
ALPINE_VERSION=3.24.1
NGINX_VERSION=1.30.4

	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "~6",
		"vite": "^8.2.0",
		"vitest": "^5.0.1"
	}

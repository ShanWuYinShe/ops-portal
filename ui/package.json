{
	"name": "ops-portal-ui",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "svelte-kit sync && vite dev --host 0.0.0.0",

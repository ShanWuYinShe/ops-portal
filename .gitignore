# 构建产物与依赖
services/portal-backend/portal-backend
services/portal-backend/portal
services/portal-agent/agent
services/portal-agent/portal-agent
ui/node_modules/
# 双锁防复发：本项目只用 bun.lock，package-lock.json 不入库
ui/package-lock.json

# 运行期数据与秘密（不入库）
.env
cert/
# portal-backend 运行期数据（docker-compose 挂载 ./data:/app/data）
data/
logs/
*.p12
*.pem
*.key

# AI 工具的中间产物目录（计划、调研笔记、临时导出等，永不提交）
.workwork/
.v2c/

# Worktree
.worktrees/

# 系统文件
.DS_Store

# SvelteKit 构建产物
ui/.svelte-kit/
ui/build/

# portal-agent 一键接入（scripts/onboard-portal-agent.sh）在被管机仓库根
# 生成的凭据与生成物：含机器证书、长效 token、明文 enroll token，永不入库
bundle*.json
portal-agent-client.crt
portal-agent-secrets/
portal-agent-compose.generated.yml
.enroll_token.tmp

# Playwright E2E（e2e/：依赖与运行产物不入库，package-lock.json 入库）
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# portal-agent 逐机 token 落盘文件（portal-agent-compose.yml 只读挂载进容器）
agent-token

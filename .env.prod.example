# ops-portal 生产环境变量（服务器 ~/ops-portal/.env）
# 真实秘密仅存服务器，chmod 600，不入库。

COMPOSE_PROJECT_NAME=ops-portal

# --- 对外 ---
OPS_DOMAIN=ops.yinghuoren.com
PORTAL_IPV6=2605:a141:2322:2623:1::30
PORTAL_BACKEND_PORT=8319

# --- 受信代理（只认本机 nginx）---
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
TRUSTED_PROXY_HOSTS=portal-nginx

# --- 边缘透传头（与 CF Transform Rules 对齐）---
CERT_VERIFY_HEADER=X-Cert-Verify
CERT_SERIAL_HEADER=X-Cert-Serial
CERT_SUBJECT_HEADER=X-Cert-Subject
CERT_FINGERPRINT_HEADER=X-Cert-Fingerprint

# --- 本地开发免证开关（生产必须留空）---
DEV_ALLOW_NO_CERT=

# --- Cloudflare API（证书自管：签发/吊销走托管 CA）---
CF_API_TOKEN=cfat_xxx_fill_in_server
CF_ZONE_ID=3c681cb3e32fb42f0fb9ddd38dfa858f

# --- Agent token（portal 本地库签发，此处留空走库；过渡期可填单 token）---
AGENT_TOKEN=
